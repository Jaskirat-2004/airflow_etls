model TaskConfig {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true) @map("is_active")

  createdBy  String?   @map("created_by") @db.VarChar(150)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  tagGroupId Int?      @map("tag_group_id")
  tagGroup   TagGroup? @relation(fields: [tagGroupId], references: [id])

  steps           TaskStep[]
  stepExecutions  TaskStepExecution[]
  taskCaptureData TaskCaptureData[]
  taskExecutions  TaskExecution[]

  @@unique([name, tagGroupId])
  @@index([isActive])
  @@index([tagGroupId])
  @@map("task_config")
}

model TaskStep {
  id           String     @id @default(uuid())
  taskConfigId String     @map("task_config_id")
  taskConfig   TaskConfig @relation(fields: [taskConfigId], references: [id], onDelete: Cascade)

  label          String
  sequence       Int
  expectedSlaSec Int?   @default(0) @map("expected_sla_sec")

  triggerType       TaskTriggerType     @map("trigger_type")
  triggerExpression String              @map("trigger_expression")
  triggerEnd        TriggerEndCondition @map("trigger_end")

  // Example: [{ fieldName: "ticket_id", sourceType: "WindowTitle", regexPattern: "/Ticket#:(\\d+)/", isRequired: true }]

  captureFields Json @default("[]") @map("capture_fields")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stepExecutions TaskStepExecution[]

  @@unique([taskConfigId, label])
  @@unique([taskConfigId, sequence])
  @@index([taskConfigId, sequence])
  @@map("task_step")
}

model TaskExecution {
  id           String     @id @default(uuid())
  taskConfigId String     @map("task_config_id")
  taskConfig   TaskConfig @relation(fields: [taskConfigId], references: [id], onDelete: Cascade)

  userId    Int     @map("user_id")
  user      AppUser @relation(fields: [userId], references: [id])
  machineId String  @map("machine_id")

  // Tracking
  startTime   DateTime  @map("start_time") @db.Timestamptz(6)
  endTime     DateTime? @map("end_time") @db.Timestamptz(6)
  durationSec Int?      @map("duration_sec")

  // Status
  status         TaskStatus @default(IN_PROGRESS)
  completedSteps Int        @default(0) @map("completed_steps")
  totalSteps     Int        @map("total_steps")

  // Correlate all step executions
  correlationId String @unique @map("correlation_id") @db.VarChar(100)

  // Metadata
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  stepExecutions TaskStepExecution[]
  capturedData   TaskCaptureData[]

  @@index([userId, startTime])
  @@index([taskConfigId, status])
  @@index([userId, taskConfigId, startTime])
  @@index([status, startTime])
  @@index([correlationId])
  @@map("task_execution")
}

model TaskStepExecution {
  id           String     @id @default(uuid())
  taskConfigId String     @map("task_config_id")
  taskConfig   TaskConfig @relation(fields: [taskConfigId], references: [id], onDelete: Cascade)

  taskExecutionId String        @map("task_execution_id")
  taskExecution   TaskExecution @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)

  stepId String   @map("step_id")
  step   TaskStep @relation(fields: [stepId], references: [id])

  userId    Int     @map("user_id")
  user      AppUser @relation(fields: [userId], references: [id])
  machineId String  @map("machine_id")

  startTime   DateTime  @map("start_time") @db.Timestamptz(6)
  endTime     DateTime? @map("end_time") @db.Timestamptz(6)
  durationSec Int?      @map("duration_sec")

  expectedSlaSec Int     @map("expected_sla_sec")
  isSlaBreached  Boolean @default(false) @map("is_sla_breached")

  status TaskStatus @default(IN_PROGRESS)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stepCorrelationId String @unique @map("step_correlation_id") @db.VarChar(100)

  capturedData TaskCaptureData[]

  @@index([userId, startTime])
  @@index([taskConfigId, status])
  @@index([userId, taskConfigId, startTime])
  @@index([status, startTime])
  @@index([userId, status, startTime])
  @@map("task_step_execution")
}

model TaskCaptureData {
  id Int @id @default(autoincrement())

  stepExecutionId   String            @map("step_execution_id")
  taskStepexecution TaskStepExecution @relation(fields: [stepExecutionId], references: [id], onDelete: Cascade)

  taskConfigId String     @map("task_config_id")
  taskConfig   TaskConfig @relation(fields: [taskConfigId], references: [id])

  fieldName  String @map("field_name") // e.g., "ticket_id", "customer_name"
  fieldValue String @map("field_value")

  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  taskExecution   TaskExecution? @relation(fields: [taskExecutionId], references: [id])
  taskExecutionId String?

  @@index([taskExecutionId])
  @@index([stepExecutionId])
  @@index([taskConfigId, fieldName, fieldValue])
  @@index([fieldName, fieldValue])
  @@index([stepExecutionId, fieldName])
  @@map("task_capture_data")
}

